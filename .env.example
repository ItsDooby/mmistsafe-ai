# MistSafe AI Configuration

# Primary Device Selection
MISTSAFE_DEVICE_ID=MISTSAFE-ESP32-01

# MQTT Ingestion Broker
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
MQTT_TLS_CA_CERT=
MQTT_KEEPALIVE=60
MQTT_QOS=1

# Telemetry Liveness & Stale Timeout (seconds)
FRESHNESS_TIMEOUT_SEC=15

# Local AI Microservice URL
AI_SERVICE_URL=http://127.0.0.1:8008
AI_REQUEST_TIMEOUT_SEC=5

# Safety Interlock Rules
# AI stop is experimental prototype feature (disabled by default)
AI_STOP_ENABLED=false
# Threshold is prototype configuration value, not validated clinical/safety limit
AI_STOP_THRESHOLD=60.0

# Composite Scoring (disabled by default)
COMPOSITE_SCORE_ENABLED=false
COMPOSITE_VISION_WEIGHT=0.5
COMPOSITE_SENSOR_WEIGHT=0.5

# Shared Storage & File Uploads
DATABASE_PATH=mistsafe.db
UPLOAD_DIR=uploads
